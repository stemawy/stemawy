{
  "name": "stemawy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "export:admin-seed": "node --experimental-strip-types scripts/export-admin-seed.mjs",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview --config wrangler.jsonc",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --config wrangler.jsonc",
    "upload:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare upload --config wrangler.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "babel-plugin-react-compiler": "^1.0.0",
    "lucide-react": "^1.40.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.103.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
